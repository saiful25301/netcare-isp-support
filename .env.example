PROJECT_NAME="NetCare ISP Support & Complaint System"
VERSION="1.0.0"
API_V1_STR="/api/v1"

# Database Configuration:
# PostgreSQL (Production / Docker): postgresql://postgres:postgres@localhost:5432/netcare_db
# SQLite (Local Dev fallback): sqlite:///./netcare.db
DATABASE_URL="sqlite:///./netcare.db"

# Security:
SECRET_KEY="netcare-super-secret-jwt-key-for-development-change-in-production-2026"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Outage Detection Thresholds:
OUTAGE_WINDOW_MINUTES=30
OUTAGE_TICKET_THRESHOLD=3
